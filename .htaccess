# Redirige tout vers public/ pour que le document root cPanel puisse rester
# à la racine du projet (défaut d'un nouveau domaine), sans le changer vers
# <deploy_path>/public. Versionné volontairement pour être livré avec le code.
# Sans effet (et sans danger) si le document root pointe déjà sur public/.

# BEGIN Laravel Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Rediriger toutes les demandes vers le répertoire public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
# END Laravel Rewrite Rules
